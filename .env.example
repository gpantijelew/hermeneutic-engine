# ==============================================================================
# Hermeneutic Engine v53 — Local-First Configuration
# Copy this file to .env and adjust to your setup.
# ==============================================================================

# 1. BACKEND (local-first)
LLM_BACKEND=local
LOCAL_API_BASE=http://localhost:1234/v1

# 2. LM STUDIO (default — local, no API key required)
#    Start LM Studio → Developer → Enable Server (default port: 1234)
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Recommended models (load one in LM Studio before starting):
# LM_STUDIO_MODEL=qwen3.5-9b-highiq-instruct
# LM_STUDIO_MODEL=unsloth/gemma-4-E4B-it-GGUF
LM_STUDIO_MODEL=qwen3.5-9b-highiq-instruct

# 3. PIPELINE LIMITS (VRAM protection for local models)
LOCAL_RERANKER_CANDIDATES=20
LOCAL_MAX_CHUNKS=4

# ==============================================================================
# SYSTEM & EMBEDDINGS
# intfloat/multilingual-e5-large — loaded automatically via sentence-transformers
# ==============================================================================

# Disables Qwen3 thinking mode (token efficiency; harmless for other models)
LLM_SYSTEM_PREFIX=/no_think
TRANSFORMERS_VERBOSITY=error

# ==============================================================================
# OPTIONAL: Dummy / Placeholder Variables
# ==============================================================================
GOOGLE_API_KEY=
APP_PASSWORD=secret

# ==============================================================================
# OPTIONAL: Cloud APIs (not required for local operation)
# ==============================================================================
# LLM_BACKEND=vertex
# GOOGLE_CLOUD_PROJECT=your-project-id
# VERTEX_MODEL=gemini-2.5-pro

# LLM_BACKEND=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
